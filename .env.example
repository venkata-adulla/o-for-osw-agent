# Copy this file to .env and fill in real values. Never commit .env.

# --- Kore.ai ---
# Base host for Kore.ai's bot-level public APIs (getSessions, getMessagesV2, etc.)
# -- NOT the same host as the Admin Console/newer unified UI (platform.kore.ai).
# Confirm by checking what host your Bot Builder itself loads at (e.g. bots.kore.ai).
# Shared across all bots on the same account.
KORE_HOST=https://bots.kore.ai

# --- Bots ---
# One numbered group per bot (KORE_BOT_1_*, KORE_BOT_2_*, ...) -- the
# pipeline and dashboard pick up however many groups are present
# automatically, no code changes needed. Each bot needs its OWN Client
# ID/Secret from a BOT-LEVEL app: open that bot in Bot Builder, then
# Deploy > APIs & Extensions > Manage Apps (create/select an app) and
# Deploy > APIs & Extensions > API Scopes (assign it scopes). This is NOT
# the same as an Admin Console app (Bot Admin Console > Security & Control
# > API Scopes) -- that one is account-wide and only authorizes
# admin/account operations, not bot-runtime APIs like getSessions.
# See docs/RUNBOOK.md Phase 0.
#
# To add another bot, copy this block, bump the number, and fill it in --
# nothing else in the repo needs to change.
KORE_BOT_1_ID=
KORE_BOT_1_NAME=
KORE_BOT_1_CLIENT_ID=
KORE_BOT_1_CLIENT_SECRET=
KORE_BOT_1_ENV=DEV

# KORE_BOT_2_ID=
# KORE_BOT_2_NAME=
# KORE_BOT_2_CLIENT_ID=
# KORE_BOT_2_CLIENT_SECRET=
# KORE_BOT_2_ENV=DEV

# --- Zendesk ---
# One account (subdomain), shared across every bot/brand -- Zendesk's own
# "brand" concept (multiple cruise-line client brands can live under one
# Zendesk account) is a field on each ticket, not a separate credential set,
# so this is a single global config like KORE_HOST above, not a numbered
# per-bot group. Basic auth is "<email>/token" as the username, the API
# token as the password -- built at request time from these two values.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=osw_bot_analytics
POSTGRES_USER=osw
POSTGRES_PASSWORD=change_me_locally
# Default is 10 if unset; raise if a page's parallel query count grows
# (see the Tickets page, which alone fires ~15 per load).
POSTGRES_POOL_MAX=25

# --- Claude (via OpenRouter) ---
# agent_service reaches Claude through OpenRouter's OpenAI-compatible API
# rather than calling Anthropic directly -- same model, different transport.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Pipeline ---
# Cron expression for the ETL pull (default: every 10 minutes). Kept
# frequent, not once daily, so the dashboard doesn't lag real activity by up
# to a full day -- see pipeline/scheduler.py for why the pull window itself
# (not just this schedule) had to change to make that actually work.
PIPELINE_CRON=*/10 * * * *

# --- Services ---
AGENT_SERVICE_PORT=8000
DASHBOARD_PORT=3000
# Base URL the dashboard (server-side) uses to reach agent_service inside the compose network
AGENT_SERVICE_INTERNAL_URL=http://agent_service:8000
